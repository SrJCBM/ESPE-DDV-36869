[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"recaudador": {"nombre": "El Recaudador", "retrato": "res://casino/arte/personaje_recaudador.webp", "expresiones": "res://historia/retratos/recaudador_%s.webp"}, "narrador": {"nombre": ""}}
entradas = [{"si": "mesa_superada", "ir": "revisita"}, {"ir": "presentacion_1"}]
intervenciones = {"presentacion_1": {"personaje": "recaudador", "texto": "«{apellido}, {nombre}. Entrada reciente. Origen: garantía.»", "siguiente": "asiento"}, "asiento": {"personaje": "recaudador", "texto": "«Quince fichas de cortesía al sentarse, una sola vez. Cada carta que pida después del reparto cuesta una. Umbral {umbral}, meta {meta}, {campanadas} campanadas. Hasta el azar lleva cuentas.»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}]}, "asiento_otra": {"personaje": "recaudador", "texto": "«¿Te sientas, entonces?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "respuesta_0_1": {"personaje": "recaudador", "texto": "«Porque es lo que usted es.»", "siguiente": "garantia_1"}, "respuesta_1_1": {"personaje": "recaudador", "texto": "«Todo lo que entra y todo lo que sale. Años, fichas, caras. Cada visitante tiene su página, y todas terminan igual: con una raya.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_2_1": {"personaje": "recaudador", "texto": "«Porque pedir es desear, y el deseo es la mercancía más cara de la Casa. Levantarse, en cambio, no cuesta nada. Pocos lo hacen.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_3_1": {"personaje": "recaudador", "texto": "«Prestamista. Perdí en esta mesa contra mi propio libro. Ahora cobro para siempre.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "preguntas": {"personaje": "recaudador", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Por qué dice «garantía»?", "ir": "respuesta_0_1", "si": "no:historia:garantia"}, {"texto": "¿Qué anota en ese libro?", "ir": "respuesta_1_1"}, {"texto": "¿Por qué cobra por pedir?", "ir": "respuesta_2_1"}, {"texto": "¿Qué era usted antes?", "ir": "respuesta_3_1"}, {"texto": "Nada más", "ir": "asiento_otra"}], "fondo": ""}, "preguntas_revisita": {"personaje": "recaudador", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Quién le enseñó a llevar un libro así?", "ir": "pos_respuesta_1", "si": "no:historia:recaudador_pos_respuesta_1"}, {"texto": "¿Quién convirtió el tiempo en deuda?", "ir": "pos_respuesta_2", "si": "no:historia:recaudador_pos_respuesta_2"}, {"texto": "¿Hay más garantías de Corvera en su libro?", "ir": "pos_respuesta_3", "si": "no:historia:recaudador_pos_respuesta_3"}, {"texto": "Nada más", "ir": ""}], "fondo": ""}, "revisita": {"personaje": "recaudador", "texto": "«Su página sigue abierta. Pregunte, si quiere. Las respuestas también se anotan. Las preguntas tontas, en rojo.»", "siguiente": "preguntas_revisita", "fondo": ""}, "victoria": {"personaje": "recaudador", "texto": "«{meta}. La cuenta cuadra. Segundo sello. Años restantes: menos de los que cree. Gástelos con criterio.»"}, "derrota": {"personaje": "recaudador", "texto": "«Saldo cero. Garantía ejecutada por segunda vez. Archivado.»"}, "garantia_1": {"personaje": "narrador", "texto": "El Recaudador pasa páginas sin mirar y gira el libro hacia mí.", "siguiente": "garantia_2", "fondo": "cg_libro_mayor", "solicitud": "historia:garantia"}, "garantia_2": {"personaje": "recaudador", "texto": "«Ferrer, Ignacio. Diecisiete campanadas. Sin saldo. Solicitó una mano adicional y ofreció garantía. Usted.»", "siguiente": "garantia_3", "expresion": "satisfecho"}, "garantia_3": {"personaje": "narrador", "modo": "nvl", "pagina_nueva": true, "texto": "No es su letra. Es la del Recaudador, limpia, exacta, sin temblor. Pero las palabras son de Ignacio.", "siguiente": "garantia_4"}, "garantia_4": {"personaje": "narrador", "modo": "nvl", "texto": "Tengo un aprendiz. Buenas manos. Muchos años por delante.", "siguiente": "garantia_5"}, "garantia_5": {"personaje": "narrador", "modo": "nvl", "texto": "Me vendió. Por una mano. Por treinta puntos.", "siguiente": "garantia_6"}, "garantia_6": {"personaje": "recaudador", "fondo": "", "texto": "«La mayoría se queda callada un momento. Luego se sientan.»", "opciones": [{"texto": "Miente.", "ir": "garantia_miente"}, {"texto": "…", "ir": "garantia_silencio"}, {"texto": "¿Y si gano?", "ir": "garantia_gano"}]}, "garantia_miente": {"personaje": "recaudador", "texto": "«Yo no miento. Yo anoto.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "garantia_silencio": {"personaje": "recaudador", "texto": "«La mayoría reacciona así. Luego se sientan. Siéntese.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "garantia_gano": {"personaje": "recaudador", "texto": "«Entonces la garantía queda saldada y usted sale con los años que le queden. O con los que sepa reclamar; esa columna no la llevo yo. La deuda de Ferrer, en cambio, no se salda nunca.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "pos_respuesta_1": {"personaje": "recaudador", "solicitud": "historia:recaudador_pos_respuesta_1", "siguiente": "preguntas_revisita", "texto": "«Mi padre. Llevaba las cuentas de un convento de Corvera. Me enseñó que una deuda no es dinero: es una promesa que alguien todavía no puede cumplir.»\n\n«Luego descubrí que también es poder. Arranqué la página donde lo había escrito.»"}, "pos_respuesta_2": {"personaje": "recaudador", "solicitud": "historia:recaudador_pos_respuesta_2", "siguiente": "preguntas_revisita", "expresion": "impaciente", "texto": "«Nadie lo decidió. El Dueño apostó una noche entera y no tenía con qué cubrirla. La Casa le fió el amanecer, y nosotros cobramos los intereses.»\n\n«Usted no paga su deuda, {apellido}. Paga la de él.»"}, "pos_respuesta_3": {"personaje": "recaudador", "solicitud": "historia:recaudador_pos_respuesta_3", "texto": "«Cuarenta y una páginas con dirección de Corvera. El muelle, la calle de los Toneleros, el barrio del hospicio. Padres que ofrecieron a sus hijos, socios que ofrecieron a sus socios.»\n\n«En su puerto hay prestamistas que hacen lo mismo con papel sellado y sin Casa. Yo fui uno. La única diferencia es que aquí se anota todo.»", "opciones": [{"texto": "Usted también tiene una página de Corvera.", "ir": "", "solicitud": "ver_recuerdo"}, {"texto": "Otra pregunta.", "ir": "preguntas_revisita"}]}, "pos_fin_recuerdo": {"personaje": "recaudador", "expresion": "neutral", "texto": "«Sigue abierta. Es la única línea de este libro que no he podido cerrar.»\n\n«Continúe.»", "siguiente": "preguntas_revisita"}}
fondos = {"cg_libro_mayor": {"ruta": "res://historia/ilustraciones/cg_libro_mayor.webp", "movimiento": "acercar", "descripcion": "El libro mayor abierto bajo una lámpara granate, con una línea subrayada en tinta roja."}}
