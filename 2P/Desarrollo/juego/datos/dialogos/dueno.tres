[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"dueno": {"nombre": "Dueño de la Casa", "retrato": "res://casino/arte/personaje_dueno.webp", "expresiones": "res://historia/retratos/dueno_%s.webp"}, "narrador": {"nombre": ""}}
entradas = [{"si": "mesa_superada", "ir": "revisita"}, {"si": "historia:prologo_visto", "ir": "recuerdo"}, {"ir": "presentacion_1"}]
intervenciones = {"presentacion_1": {"personaje": "dueno", "texto": "«Relojero. Ocupas una silla que todavía está tibia.»", "siguiente": "asiento", "expresion": "interes", "fondo": ""}, "asiento": {"personaje": "dueno", "texto": "«¿Ya distingues el alba tras la verja? Empiezas en {umbral}. Cada mano que cierres sin pasarte me devuelve un paso, hasta diecisiete. Meta {meta}, {campanadas} campanadas. Las mismas que tenía él.»", "siguiente": [{"si": "historia:motivo=taller", "ir": "motivo_taller"}, {"si": "historia:motivo=ignacio", "ir": "motivo_ignacio"}, {"si": "historia:motivo=curiosidad", "ir": "motivo_curiosidad"}, {"si": "historia:garantia", "ir": "motivo_garantia"}, {"ir": "asiento_tras"}]}, "asiento_tras": {"personaje": "dueno", "texto": "«¿Te sientas?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "asiento_otra": {"personaje": "dueno", "texto": "«¿Te sientas, entonces?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "respuesta_0_1": {"personaje": "dueno", "texto": "«Un jugador que ganó demasiado. Aposté contra el amanecer y me quedé la noche. Lo hice por alguien que iba a morir al salir el sol. Nadie me dijo que la noche, después, no se puede devolver, ni que uno olvida su propia cara si pasa mucho tiempo sin luz.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_1_1": {"personaje": "dueno", "texto": "«Porque la noche se estrecha cuanto más te acercas al alba. Cada mano limpia me quita espacio. Es la única regla de esta Casa que juega a tu favor. También es la que más caras me ha dado.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_2_1": {"personaje": "dueno", "texto": "«Porque él la ofreció. Yo no pido nada, relojero. Nunca he tenido que pedir. Los hombres me ofrecen lo que más quieren en cuanto les falta una mano.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_3_1": {"personaje": "dueno", "texto": "«Gáname, y hablaremos de lo que una victoria puede comprar. Aunque quizá, cuando ganes, ya no quieras comprarlo.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "preguntas": {"personaje": "dueno", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Qué es usted?", "ir": "respuesta_0_1"}, {"texto": "¿Por qué baja su umbral?", "ir": "respuesta_1_1"}, {"texto": "¿Por qué aceptó la garantía?", "ir": "respuesta_2_1", "si": "historia:garantia"}, {"texto": "Devuélvame a Ignacio.", "ir": "respuesta_3_1"}, {"texto": "Nada más", "ir": "asiento_otra"}], "fondo": ""}, "preguntas_revisita": {"personaje": "dueno", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Qué siente ahora que ha perdido?", "ir": "pos_respuesta_1", "si": "no:historia:dueno_pos_respuesta_1"}, {"texto": "¿Cómo fue la noche de la apuesta?", "ir": "pos_respuesta_2", "si": "no:historia:dueno_pos_respuesta_2"}, {"texto": "¿Qué me espera en Corvera?", "ir": "pos_corvera", "si": "no:historia:dueno_pos_respuesta_3"}, {"texto": "Nada más", "ir": ""}], "fondo": ""}, "revisita": {"personaje": "dueno", "texto": "«La mesa está cerrada. La verja, abierta. ¿Qué más quieres preguntarme?»", "siguiente": "preguntas_revisita", "fondo": ""}, "victoria": {"personaje": "dueno", "texto": "«{meta}. Había olvidado cómo suena perder. Suena como un reloj. La verja está abierta.»"}, "derrota": {"personaje": "dueno", "texto": "«La decimoséptima. Como él. Anfitriona.»"}, "motivo_taller": {"personaje": "dueno", "texto": "«Vienes a salvar una tienda de relojes. Esta noche te he quitado más años de los que esa tienda tiene.»", "siguiente": [{"si": "historia:garantia", "ir": "motivo_garantia"}, {"ir": "asiento_tras"}]}, "motivo_ignacio": {"personaje": "dueno", "texto": "«Vienes por el maestro. Qué lealtad. Él no te la tuvo.»", "siguiente": [{"si": "historia:garantia", "ir": "motivo_garantia"}, {"ir": "asiento_tras"}]}, "motivo_curiosidad": {"personaje": "dueno", "texto": "«Quieres ver el mecanismo. Siéntate. Yo soy el mecanismo.»", "siguiente": [{"si": "historia:garantia", "ir": "motivo_garantia"}, {"ir": "asiento_tras"}]}, "motivo_garantia": {"personaje": "dueno", "texto": "«Ya sabes cómo llegaste. Bien. Odio tener que explicarlo.»", "siguiente": "asiento_tras"}, "recuerdo": {"personaje": "narrador", "modo": "nvl", "pagina_nueva": true, "fondo": "sala_dueno_noche", "texto": "Lo he visto antes. No puedo haberlo visto, y lo he visto: en el principio de esta noche, sentado frente a Ignacio, aceptando mi nombre como quien acepta una moneda.", "siguiente": "presentacion_1"}, "pos_respuesta_1": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_1", "siguiente": "preguntas_revisita", "texto": "«Frío. Hacía siglos que la Casa no me dejaba sentir la hora. Ahora sé que son las doce y tres minutos. Noto cada uno.»\n\n«Es como volver a tener pulso. No sé si me gusta.»"}, "pos_respuesta_2": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_2", "expresion": "cansancio", "texto": "«La recuerdo mejor que mi nombre. Ella tosía arriba y yo bajé a jugar con lo único que me quedaba.»", "opciones": [{"texto": "¿Contra quién jugó?", "ir": "", "solicitud": "ver_recuerdo"}, {"texto": "Otra pregunta.", "ir": "preguntas_revisita"}]}, "pos_corvera": {"personaje": "dueno", "texto": "«Corvera sigue ahí.»", "siguiente": [{"si": "historia:final.fichas=propias", "ir": "pos_fichas_propias"}, {"si": "historia:final.fichas=todas", "ir": "pos_fichas_todas"}, {"si": "historia:final.fichas=ninguna", "ir": "pos_fichas_ninguna"}, {"ir": "pos_respuesta_3"}]}, "pos_fichas_propias": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_3", "siguiente": "preguntas_revisita", "expresion": "interes", "texto": "«La misma noche. Tu taller sin pagar, tus vecinos dormidos. Nadie sabrá dónde estuviste. Tú sí, y eso pesa más que una deuda.»"}, "pos_fichas_todas": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_3", "siguiente": "preguntas_revisita", "expresion": "interes", "texto": "«Una vida larga. Verás irse a todos los que conoces. Acostúmbrate pronto; yo nunca lo conseguí.»"}, "pos_fichas_ninguna": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_3", "siguiente": "preguntas_revisita", "expresion": "interes", "texto": "«No lo sé. Pasaron allí los años que te cobré. Quizá tu taller ya no exista. Mira primero el mar: eso no cambia.»"}, "pos_respuesta_3": {"personaje": "dueno", "solicitud": "historia:dueno_pos_respuesta_3", "siguiente": "preguntas_revisita", "expresion": "interes", "texto": "«Mira primero el mar. Eso no cambia.»"}, "pos_fin_recuerdo": {"personaje": "dueno", "expresion": "cansancio", "texto": "«Esa es la noche que acabas de ganarme. Cuídala mejor que yo.»", "siguiente": "preguntas_revisita"}}
fondos = {"sala_dueno_noche": {"ruta": "res://historia/ilustraciones/sala_dueno_noche.webp", "movimiento": "desplazar", "descripcion": "La sala del Dueño de noche, como en la apertura."}}
