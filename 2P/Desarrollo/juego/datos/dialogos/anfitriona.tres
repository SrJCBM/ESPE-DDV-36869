[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"anfitriona": {"nombre": "La anfitriona", "retrato": "res://casino/arte/personaje_anfitriona.webp", "expresiones": "res://historia/retratos/anfitriona_%s.webp"}, "narrador": {"nombre": ""}}
entradas = [{"si": "no:historia:tono", "ir": "llegada"}, {"si": "sin_invitacion", "ir": "saludo"}, {"si": "sellos==0", "ir": "pista_0"}, {"si": "sellos==1", "ir": "pista_1"}, {"si": "sellos==2", "ir": "pista_2"}, {"si": "sellos==3", "ir": "pista_3"}, {"ir": "pista_4"}]
intervenciones = {"llegada": {"personaje": "anfitriona", "texto": "«Llegas a la hora exacta. Aquí todos los relojes se detuvieron esperando a alguien. Esta noche, a ti.»", "opciones": [{"texto": "Buenas noches. Creo que me esperaban.", "ir": "tono_cortes", "solicitud": "historia:tono=cortes"}, {"texto": "¿Dónde está la salida?", "ir": "tono_desconfiado", "solicitud": "historia:tono=desconfiado"}, {"texto": "No pienso quedarme.", "ir": "tono_desafiante", "solicitud": "historia:tono=desafiante"}, {"texto": "Bonito reloj. Lástima que esté roto.", "ir": "tono_burlon", "solicitud": "historia:tono=burlon"}]}, "tono_cortes": {"personaje": "anfitriona", "texto": "«Desde hace un año. Eres educado. Lo fueron casi todos, al principio.»", "siguiente": "puerta_abierta", "expresion": "sonrisa_leve"}, "tono_desconfiado": {"personaje": "anfitriona", "texto": "«Detrás de cuatro mesas y una verja. Nadie te la esconde. Solo te la cobra.»", "siguiente": "puerta_abierta"}, "tono_desafiante": {"personaje": "anfitriona", "texto": "«Nadie lo piensa. Ellos tampoco lo pensaban.»", "siguiente": "puerta_abierta"}, "tono_burlon": {"personaje": "anfitriona", "texto": "«No está roto. Está esperando. Tú deberías entender la diferencia, relojero.»", "siguiente": "puerta_abierta", "expresion": "sonrisa_leve"}, "puerta_abierta": {"personaje": "anfitriona", "texto": "«La puerta seguirá abierta hasta que me des tu invitación. Puedes irte. Nadie lo hace. Es lo que más me gusta de esta profesión.»", "siguiente": "saludo"}, "saludo": {"personaje": "anfitriona", "texto": "«Tu invitación.»", "opciones": [{"texto": "Entregar la invitación", "ir": "invitacion_quemada", "si": "historia:quemo_invitacion"}, {"texto": "Entregar la invitación", "ir": "invitacion", "si": "no:historia:quemo_invitacion"}, {"texto": "Volver", "ir": ""}]}, "invitacion_quemada": {"personaje": "anfitriona", "texto": "«Huele a lámpara. La intentaste quemar. Todos lo intentan. Las invitaciones no arden: están escritas con lo que se debe, y las deudas no se queman.»", "siguiente": "ferrer"}, "invitacion": {"personaje": "anfitriona", "texto": "«La tinta todavía no ha secado. Es reciente.»", "siguiente": "ferrer"}, "ferrer": {"personaje": "anfitriona", "texto": "«Ferrer. Tenía buenas manos. Las tuyas también lo son. Eso dijo él.»", "expresion": "seria", "opciones": [{"texto": "¿Conoció a Ignacio? ¿Dónde está?", "ir": "ferrer_donde"}, {"texto": "¿Qué quiere decir con «eso dijo él»?", "ir": "ferrer_dijo"}, {"texto": "No vine a hablar de él.", "ir": "ferrer_no"}]}, "ferrer_donde": {"personaje": "anfitriona", "texto": "«Más cerca de lo que crees. Más lejos de lo que podrías traerlo. Gana dos mesas. Entonces mira bien las vitrinas.»", "siguiente": "oferta"}, "ferrer_dijo": {"personaje": "anfitriona", "texto": "«Que hablaba de ti. Al final, hablaba mucho de ti. No me preguntes más. No esta noche.»", "siguiente": "oferta", "expresion": "seria"}, "ferrer_no": {"personaje": "anfitriona", "texto": "«Claro que no. Él tampoco quería hablar de ti. Y lo hizo igual.»", "siguiente": "oferta"}, "oferta": {"personaje": "anfitriona", "texto": "«Veinticuatro cartas y diez fichas serán tuyas. Además, la Casa te concede una de estas piezas, una sola vez. No es un regalo. Aquí no hay regalos.»", "opciones": [{"texto": "Lente de humo", "ir": "entrega_lente", "solicitud": "objeto_inicial:lente"}, {"texto": "Sello del prudente", "ir": "entrega_prudente", "solicitud": "objeto_inicial:prudente"}, {"texto": "Moneda mellada", "ir": "entrega_moneda", "solicitud": "objeto_inicial:moneda"}, {"texto": "Pensarlo un momento", "ir": ""}]}, "entrega_lente": {"personaje": "anfitriona", "texto": "«Para mirar a las Máscaras a la cara antes de tiempo. Algunos prefieren no hacerlo.»", "siguiente": "puerta_cierra"}, "entrega_prudente": {"personaje": "anfitriona", "texto": "«El de los que saben levantarse. Ferrer lo despreció.»", "siguiente": "puerta_cierra"}, "entrega_moneda": {"personaje": "anfitriona", "texto": "«La de los que buscan la cifra exacta. La Casa paga la exactitud. Es lo único que paga bien.»", "siguiente": "puerta_cierra"}, "puerta_cierra": {"personaje": "narrador", "texto": "Detrás de mí, la puerta por la que entré se cierra. Al girarme, en su lugar solo hay una pared de mármol verde con el contorno de una puerta grabado. No hay picaporte. No hay bisagras. Solo el dibujo de una puerta, como si alguien la hubiera recordado mal.", "siguiente": [{"si": "historia:motivo=taller", "ir": "motivo_taller"}, {"si": "historia:motivo=ignacio", "ir": "motivo_ignacio"}, {"si": "historia:motivo=curiosidad", "ir": "motivo_curiosidad"}, {"ir": "entrega"}], "modo": "nvl", "pagina_nueva": true, "sonido": "puerta", "fondo": "cg_puerta_grabada"}, "motivo_taller": {"personaje": "anfitriona", "texto": "«Si sales, la Casa paga lo que promete. Pero recuerda que aquí no se paga en pesos. Se paga en años.»", "siguiente": "entrega", "fondo": ""}, "motivo_ignacio": {"personaje": "anfitriona", "texto": "«Buscas a alguien. Eso te hará pedir una carta más cuando no debes. Así empezó él.»", "siguiente": "entrega", "fondo": ""}, "motivo_curiosidad": {"personaje": "anfitriona", "texto": "«Quieres ver el mecanismo. Te lo enseñarán. Desde dentro.»", "siguiente": "entrega", "fondo": ""}, "entrega": {"personaje": "anfitriona", "texto": "«La tienda queda más allá del Custodio: gánate su sello y la encontrarás junto al Recaudador. Cada campanada que oigas será un año tuyo. Cuéntalas.»", "fondo": ""}, "saludo_cortes": {"personaje": "anfitriona", "texto": "«Sigues siendo educado. Bien. Escucha:» "}, "saludo_desconfiado": {"personaje": "anfitriona", "texto": "«Sigues buscando la salida. Escucha:» "}, "saludo_desafiante": {"personaje": "anfitriona", "texto": "«Sigues aquí. Escucha:» "}, "saludo_burlon": {"personaje": "anfitriona", "texto": "«¿Vienes a burlarte de otro reloj? Escucha primero:» "}, "pista_0": {"personaje": "anfitriona", "texto": "{saludo}«El reloj verde pertenece al Custodio. Sal al pasillo y busca la puerta iluminada del norte. Él cuenta las campanadas. Diez. Diez años. Aprende a contarlas con él.»", "opciones": [{"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Nada más", "ir": ""}]}, "pista_1": {"personaje": "anfitriona", "texto": "{saludo}«Su sello abre la puerta del este. Allí esperan el Recaudador y mi tienda. Él adelanta quince fichas al sentarte y cobra una por cada carta que pidas después del reparto. Nada es gratis en su mesa, salvo levantarse.»", "opciones": [{"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Nada más", "ir": ""}]}, "pista_2": {"personaje": "anfitriona", "texto": "{saludo}«Ella colecciona lo que más vale. Al cerrar cada mano se queda con tu carta más alta, aunque te hayas pasado. Vigila qué queda en tu mazo. Y mira sus vitrinas. Ya es hora de que sepas.»", "opciones": [{"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Nada más", "ir": ""}]}, "pista_3": {"personaje": "anfitriona", "texto": "{saludo}«Tres sellos. El reloj quiere moverse; ¿lo oyes? El Dueño ya sabe que has llegado. Su umbral empieza en veinticinco y baja uno por cada mano que cierres sin pasarte, hasta diecisiete. Diecisiete. El mismo número en el que se quedó Ferrer.»", "opciones": [{"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Nada más", "ir": ""}]}, "pista_4": {"personaje": "anfitriona", "texto": "{saludo}«Oigo el pestillo. Vuelve al portón detrás de la última mesa. Vete. No mires atrás. Y no me des las gracias: alguien tiene que recibir al siguiente, y ya tengo su nombre.»", "opciones": [{"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Nada más", "ir": ""}]}, "respuesta_0": {"personaje": "anfitriona", "texto": "«La Casa. Vive en la hora que no termina, entre la última campanada de la medianoche y el amanecer. Afuera ha pasado un segundo desde que cruzaste la puerta. Aquí dentro han pasado siglos, y seguirán pasando.»", "siguiente": "preguntas"}, "respuesta_1": {"personaje": "anfitriona", "texto": "«Porque el Dueño le ganó la noche al amanecer. Mientras alguien juegue en sus mesas, el sol no sale aquí y él no envejece. Las tres ranuras del reloj son las cerraduras de ese trato.»", "siguiente": "preguntas"}, "respuesta_2": {"personaje": "anfitriona", "texto": "«Años. Cada mano nueva hace sonar una, y la Casa se queda con un año tuyo. Mírate las manos al salir de cada mesa.»", "siguiente": "preguntas"}, "respuesta_3": {"personaje": "anfitriona", "texto": "«Mira las Máscaras de tu baraja. Están despiertas. Sienten tus dedos cada vez que las juegas. Juega con cuidado. Por ellas también.»", "siguiente": "preguntas", "expresion": "seria"}, "respuesta_4": {"personaje": "anfitriona", "texto": "«Pierden despacio. Una mano, un dedo. Un intento, una muñeca. Cuando la porcelana les llegue a la cara, me tocará guardarlos. Estas llaves no abren puertas. Abren vitrinas.»", "siguiente": "preguntas"}, "respuesta_5": {"personaje": "anfitriona", "texto": "«Porque alguien te puso en la mesa. Pregúntale al Recaudador. Él anota quién paga qué.»", "siguiente": "preguntas"}, "respuesta_6": {"personaje": "anfitriona", "texto": "«Visitantes que llegaron hasta su mesa y perdieron. La Casa no los convirtió en Máscaras; los ató a la silla. No pueden levantarse. Nunca.»", "siguiente": "preguntas"}, "respuesta_7": {"personaje": "anfitriona", "texto": "«Salí una vez. Vi el amanecer. Todos los que conocía llevaban sesenta años muertos. Mi casa era una fábrica. Nadie decía mi nombre. Volví esa misma noche. Aquí, al menos, alguien me espera: el siguiente.»", "siguiente": "preguntas", "expresion": "compasiva"}, "respuesta_8": {"personaje": "anfitriona", "texto": "«No recuerda su cara. Juega para no tener que pensar en eso. Cada Máscara que gana es una cara más que mirar, en lugar de la suya.»", "siguiente": "preguntas"}, "preguntas": {"personaje": "anfitriona", "texto": "«Pregunta. Las respuestas no cuestan campanadas.»", "opciones": [{"texto": "¿Qué es este lugar?", "ir": "respuesta_0"}, {"texto": "¿Por qué los relojes están parados?", "ir": "respuesta_1"}, {"texto": "¿Qué son las campanadas?", "ir": "respuesta_2"}, {"texto": "¿Qué les pasa a los que pierden?", "ir": "respuesta_3"}, {"texto": "¿Qué les pasa a esos jugadores?", "ir": "respuesta_4"}, {"texto": "¿Por qué me invitaron a mí?", "ir": "respuesta_5"}, {"texto": "¿Quiénes son los crupieres?", "ir": "respuesta_6", "si": "sellos>=1"}, {"texto": "¿Usted puede salir?", "ir": "respuesta_7", "si": "sellos>=2"}, {"texto": "¿Qué quiere el Dueño?", "ir": "respuesta_8", "si": "sellos>=3"}, {"texto": "Nada más", "ir": ""}]}}
fondos = {"cg_puerta_grabada": {"ruta": "res://historia/ilustraciones/cg_puerta_grabada.webp", "descripcion": "Donde estaba la puerta del vestíbulo, una pared de mármol verde con el contorno de una puerta grabado, sin picaporte.", "movimiento": "acercar"}}
