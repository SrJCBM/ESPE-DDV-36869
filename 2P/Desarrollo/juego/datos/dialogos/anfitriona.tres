[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {
"anfitriona": {
"nombre": "La anfitriona",
"retrato": "res://casino/arte/personaje_anfitriona.webp"
}
}
entradas = [{
"ir": "saludo",
"si": "sin_invitacion"
}, {
"ir": "pista_0",
"si": "sellos==0"
}, {
"ir": "pista_1",
"si": "sellos==1"
}, {
"ir": "pista_2",
"si": "sellos==2"
}, {
"ir": "pista_3",
"si": "sellos==3"
}, {
"ir": "pista_4"
}]
intervenciones = {
"entrega": {
"personaje": "anfitriona",
"texto": "«Veinticuatro cartas y diez fichas. Son tuyas. La tienda abre al otro lado de la galería. Cuando estés listo, toma asiento ante el Custodio.»"
},
"pista_0": {
"personaje": "anfitriona",
"texto": "«El reloj verde pertenece al Custodio. Sal a la galería y busca la primera puerta iluminada.»"
},
"pista_1": {
"personaje": "anfitriona",
"texto": "«El Recaudador adelanta quince fichas. Te cobrará una por cada carta que pidas tras el reparto.»"
},
"pista_2": {
"personaje": "anfitriona",
"texto": "«Ella colecciona lo que más vale. Vigila qué carta se queda después de cada mano.»"
},
"pista_3": {
"personaje": "anfitriona",
"texto": "«Tres sellos. El Dueño ya sabe que has llegado. Mira la luz tras su mesa.»"
},
"pista_4": {
"personaje": "anfitriona",
"texto": "«Oigo el pestillo. Vuelve al portón detrás de la última mesa.»"
},
"saludo": {
"opciones": [{
"ir": "entrega",
"solicitud": "entregar_invitacion",
"texto": "Entregar la invitación"
}, {
"ir": "",
"texto": "Volver"
}],
"personaje": "anfitriona",
"texto": "«Llegas a la hora exacta. Aquí todos los relojes se detuvieron esperando a alguien. ¿Me dejas ver tu invitación?»"
}
}
