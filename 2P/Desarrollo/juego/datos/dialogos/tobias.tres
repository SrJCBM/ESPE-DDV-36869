[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"tobias": {"nombre": "Tobías"}, "narrador": {"nombre": ""}}
entradas = [{"si": "historia:tobias.estado=cobrado", "ir": "cobrado"}, {"si": "sellos>=3", "ir": "porcelana"}, {"ir": "saludo"}]
intervenciones = {"respuesta_1": {"personaje": "tobias", "texto": "«Que el diecisiete es un número pequeño. Que un dieciséis es una mano muy buena. Que plantarse no es cobardía. Lo aprendí todo con la novena campanada. Demasiado tarde.»", "siguiente": "preguntas"}, "respuesta_2": {"personaje": "tobias", "texto": "«No tengo invitación. La mía la reescribieron para otro. Ese otro también perdió. Ahora es una de las caras de su baraja, señor. Quizá la ha jugado.»", "siguiente": "preguntas"}, "respuesta_3": {"personaje": "tobias", "texto": "«Señor… si sale, ¿podría decirle a alguien en el puerto que el cadete Tobías Lara no desertó? Que lo tragó la niebla. Que no huyó.»\n\n«Mi madre cree que huí.»", "siguiente": "preguntas", "expresion": "triste"}, "saludo": {"personaje": "tobias", "texto": "«Diez campanadas, y gasté nueve en las primeras manos. Quería asegurarme, ¿entiende? Pedir hasta estar seguro. Nadie está seguro aquí.»", "opciones": [{"texto": "¿Qué aprendió?", "ir": "respuesta_1"}, {"texto": "¿Por qué no se va?", "ir": "respuesta_2"}, {"texto": "Ánimo, cadete.", "ir": "respuesta_3"}, {"texto": "Volver al recorrido", "ir": ""}]}, "preguntas": {"personaje": "tobias", "texto": "¿Quieres preguntar algo más?", "opciones": [{"texto": "¿Qué aprendió?", "ir": "respuesta_1"}, {"texto": "¿Por qué no se va?", "ir": "respuesta_2"}, {"texto": "Ánimo, cadete.", "ir": "respuesta_3"}, {"texto": "Volver al recorrido", "ir": ""}]}, "porcelana": {"personaje": "narrador", "texto": "Un cadete de porcelana mira la puerta del Custodio."}, "cobrado": {"personaje": "narrador", "texto": "Un cadete de porcelana mira la puerta del Custodio. En la mejilla tiene escrita, con tinta roja, la palabra «saldado»."}}
