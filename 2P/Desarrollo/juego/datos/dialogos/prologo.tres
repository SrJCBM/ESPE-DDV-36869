[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"narrador": {"nombre": ""}, "dueno": {"nombre": "Dueño de la Casa", "retrato": "res://casino/arte/personaje_dueno.webp", "expresiones": "res://historia/retratos/dueno_%s.webp"}, "ignacio": {"nombre": "Ignacio Ferrer", "expresiones": "res://historia/retratos/ignacio_%s.webp"}, "anfitriona": {"nombre": "La anfitriona", "retrato": "res://casino/arte/personaje_anfitriona.webp", "expresiones": "res://historia/retratos/anfitriona_%s.webp"}, "farolero": {"nombre": "Farolero", "expresiones": "res://historia/retratos/farolero_%s.webp"}}
entradas = [{"ir": "p0_1"}]
intervenciones = {"p0_1": {"personaje": "narrador", "texto": "Diecisiete campanadas. Ignacio Ferrer las había contado todas.", "siguiente": "p0_2", "modo": "nvl", "fondo": "sala_dueno_noche", "pagina_nueva": true}, "p0_2": {"personaje": "narrador", "texto": "Diecisiete años. Se los había visto irse en el dorso de las manos: las venas más gruesas, las manchas más oscuras, los nudillos hinchados de un viejo que no era él cuando entró.", "siguiente": "p0_3", "modo": "nvl"}, "p0_3": {"personaje": "narrador", "texto": "No le quedaba ninguna.", "siguiente": "p0a_1", "modo": "nvl"}, "p0a_1": {"personaje": "dueno", "texto": "«Setecientos veinte. Te faltan treinta, maestro Ferrer. Y ya no te quedan campanadas.»", "siguiente": "p0a_2", "escena": [{"entra": "dueno", "lado": "derecha"}, {"entra": "ignacio", "lado": "izquierda", "expresion": "desesperado"}]}, "p0a_2": {"personaje": "ignacio", "texto": "«Una mano. Solo una. Treinta puntos y salgo por esa verja.»", "siguiente": "p0a_3"}, "p0a_3": {"personaje": "dueno", "texto": "«Ya no tienes nada que apostar.»", "siguiente": "p0a_4"}, "p0a_4": {"personaje": "narrador", "texto": "Ignacio mira las Máscaras de las paredes. Traga saliva. Saca su reloj de bolsillo, lo abre y lo cierra varias veces.", "siguiente": "p0a_5"}, "p0a_5": {"personaje": "ignacio", "texto": "«Tengo… Tengo un aprendiz. Joven. Buenas manos. Muchos años por delante.»", "siguiente": "p0a_6", "expresion": "culpa"}, "p0a_6": {"personaje": "dueno", "texto": "«Una garantía. ¿Sabes lo que me ofreces?»", "siguiente": "p0a_7", "expresion": "interes"}, "p0a_7": {"personaje": "ignacio", "texto": "«Sé que voy a ganar.»", "siguiente": "p0a_8", "expresion": "orgullo"}, "p0a_8": {"personaje": "dueno", "texto": "«Todos lo saben. Acepto. Una mano.»", "siguiente": "p0a_9", "sonido": "campana", "efecto": "temblor"}, "p0a_9": {"personaje": "narrador", "texto": "El reparto deja sobre el tapete una Llave de 2 y un Reloj de 7, que vale 6. Ocho.", "siguiente": "p0a_10"}, "p0a_10": {"personaje": "ignacio", "texto": "«Ocho. Pido.»", "siguiente": "p0a_11", "sonido": "naipe"}, "p0a_11": {"personaje": "narrador", "texto": "La carta pedida es una Máscara, boca abajo. Ignacio la mira mucho rato. Le tiembla el labio.", "siguiente": "p0a_12"}, "p0a_12": {"personaje": "ignacio", "texto": "«Me planto.»", "siguiente": "p0b_1", "expresion": "desesperado"}, "p0b_1": {"personaje": "narrador", "texto": "La Máscara valía diez. Ignacio lo supo antes de verla, porque el frío le subió por los dedos.", "siguiente": "p0b_2", "modo": "nvl", "fondo": "cg_ignacio_mascara", "pagina_nueva": true, "sonido": "quiebra", "efecto": ["destello", "temblor_fuerte"]}, "p0b_2": {"personaje": "narrador", "texto": "Dieciocho. Uno más que el umbral. Quiebra.", "siguiente": "p0b_3", "modo": "nvl"}, "p0b_3": {"personaje": "narrador", "texto": "Quiso levantarse. Las piernas no le respondieron; ya no eran piernas. Quiso gritar, y la boca se le quedó lisa, blanca, cerrada. Lo último que movió fueron los ojos. Buscaban la verja.", "siguiente": "p0b_4", "modo": "nvl"}, "p0b_4": {"personaje": "narrador", "texto": "Luego también los cerró.", "siguiente": "p0c_1", "modo": "nvl"}, "p0c_1": {"personaje": "dueno", "texto": "«Otra cara para la baraja.»", "siguiente": "p0c_2", "fondo": "sala_dueno_noche", "escena": [{"entra": "dueno", "lado": "derecha"}, {"sale": "ignacio"}]}, "p0c_2": {"personaje": "narrador", "texto": "Donde estaba Ignacio solo queda la silla vacía. El Dueño recoge la Máscara nueva y la pasa entre los dedos. Detrás de él, en la oscuridad, la anfitriona aparece un instante, inmóvil, con una pluma en la mano.", "siguiente": "p0c_3", "escena": [{"entra": "anfitriona", "lado": "izquierda", "expresion": "seria"}]}, "p0c_3": {"personaje": "dueno", "texto": "«Anfitriona. La garantía.»", "siguiente": "p0c_4"}, "p0c_4": {"personaje": "anfitriona", "texto": "«Ya la estoy escribiendo, señor.»", "siguiente": "p0c_5"}, "p0c_5": {"personaje": "narrador", "texto": "La pluma tacha un nombre en la invitación y empieza a escribir otro. Solo se ve la primera letra.", "siguiente": "p1"}, "p1": {"personaje": "narrador", "texto": "LA ÚLTIMA MESA\nPrólogo · La garantía", "siguiente": "p2_1", "modo": "tarjeta", "fondo": "negro_con_grabado", "sonido": "campana", "escena": [{"sale": "todos"}]}, "p2_1": {"personaje": "narrador", "texto": "Hace un año que el maestro Ferrer salió a cobrar una deuda y no volvió.", "siguiente": "p2_2", "modo": "nvl", "fondo": "taller_ferrer", "pagina_nueva": true}, "p2_2": {"personaje": "narrador", "texto": "Nadie lo buscó. Los acreedores sí: vinieron todos, uno detrás de otro, con papeles firmados por él. Deudas de juego. Más de las que este taller vale.", "siguiente": "p2_3", "modo": "nvl"}, "p2_3": {"personaje": "narrador", "texto": "Mañana a las nueve viene el juzgado. Se llevarán los relojes que quedan, el banco, las herramientas. El catre donde duermo desde que tenía nueve años.", "siguiente": "p2_4", "modo": "nvl"}, "p2_4": {"personaje": "narrador", "texto": "Doy cuerda a los relojes igual. Todas las noches. Es lo único que sé hacer.", "siguiente": "p2_5", "modo": "nvl"}, "p2_5": {"personaje": "narrador", "texto": "Ignacio decía que yo tenía manos de relojero y conversación de reloj parado. Tenía razón en las dos cosas.", "siguiente": "p2b_1", "modo": "nvl"}, "p2b_1": {"personaje": "narrador", "texto": "Ignacio me recogió de la calle. Me enseñó a sostener unas pinzas, a escuchar un escape, a no tener miedo de abrir un mecanismo. Decía que las cartas son como los relojes: si entiendes el mecanismo, sabes cuándo pararte.", "siguiente": "p2b_2", "modo": "nvl", "pagina_nueva": true}, "p2b_2": {"personaje": "narrador", "texto": "Nunca supo pararse. Y yo nunca supe decírselo.", "siguiente": "p2c_1", "modo": "nvl"}, "p2c_1": {"personaje": "narrador", "texto": "Tres golpes secos en la puerta.", "siguiente": "p2c_2", "modo": "nvl", "pagina_nueva": true, "sonido": "puerta", "efecto": "temblor"}, "p2c_2": {"personaje": "narrador", "texto": "Los relojes se pararon. Todos. Treinta y dos relojes que yo mismo había ajustado. Ninguno pasó de las doce menos un minuto.", "siguiente": "p2c_3", "modo": "nvl", "fondo": "cg_relojes_parados"}, "p2c_3": {"personaje": "narrador", "texto": "En el silencio oigo mi propia respiración. Y, debajo, algo más: un roce, como de porcelana contra madera, al otro lado de la puerta.", "siguiente": "p2_que", "modo": "nvl"}, "p2_que": {"personaje": "narrador", "texto": "¿Qué haces?", "modo": "nvl", "opciones": [{"texto": "Abrir la puerta.", "ir": "p3_1"}, {"texto": "Mirar primero por la ventana.", "ir": "p2_ventana"}, {"texto": "Comprobar los relojes.", "ir": "p2_relojes"}]}, "p2_ventana": {"personaje": "narrador", "texto": "En la calle no hay nadie. Solo la niebla, y en la niebla, la farola del farolero, encendida aunque él no está. Bajo la farola, durante un segundo, me parece ver a un hombre con levita verde que no tiene cara.", "siguiente": "p3_1", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_ventana_farola"}, "p2_relojes": {"personaje": "narrador", "texto": "Abro uno. El muelle tenso, el escape limpio, el volante quieto como si lo sujetara un dedo frío. Al tocarlo, el metal está helado. No hay ninguna avería. Simplemente se niegan.", "siguiente": "p3_1", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_reloj_helado"}, "p3_1": {"personaje": "narrador", "texto": "En el umbral, sobre el escalón mojado, hay un sobre negro. No hay nadie en la calle; no hay pisadas en el barro.", "siguiente": "p3_2", "modo": "nvl", "fondo": "cg_invitacion", "pagina_nueva": true}, "p3_2": {"personaje": "narrador", "texto": "El sobre pesa más de lo que debería. Dentro hay una tarjeta color hueso y una ficha de marfil, fría como una moneda que ha pasado la noche en el río.", "siguiente": "p3_3", "modo": "nvl"}, "p3_3": {"personaje": "narrador", "texto": "La tarjeta dice: «La Casa tiene el honor de invitar a D. Ignacio Ferrer —tachado— D. {nombre} {apellido} a la última mesa. Se ruega puntualidad. La deuda no espera.»", "siguiente": "p3_4", "modo": "nvl"}, "p3_4": {"personaje": "narrador", "texto": "El nombre del maestro está tachado con una sola línea. El mío está escrito debajo, con la misma letra. La tinta todavía está húmeda. Me mancha el pulgar. Es roja.", "siguiente": "p3_que", "modo": "nvl"}, "p3_que": {"personaje": "narrador", "texto": "¿Qué haces con la invitación?", "modo": "nvl", "opciones": [{"texto": "Quemarla en la lámpara.", "ir": "p3_quemar", "solicitud": "historia:quemo_invitacion"}, {"texto": "Guardarla en el chaleco.", "ir": "p3_guardar"}, {"texto": "Darle la vuelta.", "ir": "p3_vuelta"}]}, "p3_quemar": {"personaje": "narrador", "texto": "Acerco la esquina a la llama. El papel no se oscurece, no huele, no hace nada. La llama se vuelve verde y se apaga. Todas las llamas del taller se apagan a la vez. En la oscuridad, la invitación sigue en mi mano, intacta, y la ficha me quema la palma.", "siguiente": "p3b_1", "modo": "nvl", "pagina_nueva": true, "efecto": "destello", "fondo": "cg_invitacion_arde"}, "p3_guardar": {"personaje": "narrador", "texto": "La guardo junto al pecho. El lacre late. Tardo un momento en entender que late a mi mismo ritmo.", "siguiente": "p3b_1", "modo": "nvl", "pagina_nueva": true}, "p3_vuelta": {"personaje": "narrador", "texto": "En el reverso hay una dirección: Calle del Ancla, número cero. Y debajo, con otra letra, temblorosa, casi ilegible: «Perdóname.» Conozco esa letra. La he visto en cada etiqueta de este taller.", "siguiente": "p3b_1", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_reverso_perdoname"}, "p3b_1": {"personaje": "narrador", "texto": "Ignacio estuvo allí. En ese lugar que no existe. Esta invitación fue suya antes que mía.", "siguiente": "p3b_2", "modo": "nvl", "fondo": "taller_ferrer"}, "p3b_2": {"personaje": "narrador", "texto": "No sé por qué ahora es mía. No quiero saberlo.", "siguiente": "p3_motivo", "modo": "nvl"}, "p3_motivo": {"personaje": "narrador", "texto": "¿Por qué vas a ir?", "modo": "nvl", "opciones": [{"texto": "Para salvar el taller.", "ir": "p3_taller", "solicitud": "historia:motivo=taller"}, {"texto": "Para encontrar a Ignacio.", "ir": "p3_ignacio", "solicitud": "historia:motivo=ignacio"}, {"texto": "Porque necesito saber qué es esto.", "ir": "p3_curiosidad", "solicitud": "historia:motivo=curiosidad"}]}, "p3_taller": {"personaje": "narrador", "texto": "Si esa mesa paga, pago sus deudas. Si los relojes siguen siendo suyos, Ignacio tendrá adonde volver. Me lo repito como una cuenta. Las cuentas no tienen miedo.", "siguiente": "p3_salir", "modo": "nvl", "pagina_nueva": true}, "p3_ignacio": {"personaje": "narrador", "texto": "Me dio una cama, un oficio y un apellido que la gente respetaba. Si está allí, vivo o como sea, voy a sacarlo.", "siguiente": "p3_salir", "modo": "nvl", "pagina_nueva": true}, "p3_curiosidad": {"personaje": "narrador", "texto": "Treinta y dos relojes no se paran solos. Hay un mecanismo detrás de esto, y si no lo abro yo, me abrirá a mí.", "siguiente": "p3_salir", "modo": "nvl", "pagina_nueva": true}, "p3_salir": {"personaje": "narrador", "texto": "Apago la lámpara. Los relojes siguen parados. Al salir, cierro con llave por costumbre. Detrás del cristal, el rótulo «FERRER · RELOJERÍA» queda al revés.", "siguiente": "p4_1", "modo": "nvl", "fondo": "taller_ferrer"}, "p4_1": {"personaje": "narrador", "texto": "La calle del Ancla termina en el agua. Siempre ha terminado en el agua.", "siguiente": "p4_2", "modo": "nvl", "fondo": "calle_niebla", "pagina_nueva": true, "sonido": "paso"}, "p4_2": {"personaje": "narrador", "texto": "Esta noche no. Esta noche sigue.", "siguiente": "p4_farolero", "modo": "nvl"}, "p4_farolero": {"personaje": "farolero", "texto": "«Esa ficha suena, muchacho. Desde aquí la oigo. Suena como sonaba la mía.»", "opciones": [{"texto": "¿Qué sabe usted de ese sitio?", "ir": "p4_escucho_1", "solicitud": "historia:farolero=escucho"}, {"texto": "¿Vio pasar a un hombre mayor, con levita verde? Ignacio Ferrer.", "ir": "p4_ignacio_1", "solicitud": "historia:farolero=pregunto_ignacio"}, {"texto": "No tengo tiempo. Buenas noches.", "ir": "p4_ignoro", "solicitud": "historia:farolero=ignoro"}], "fondo": "cg_farolero", "retrato": ""}, "p4_escucho_1": {"personaje": "farolero", "texto": "«Que yo salí. Gané las cuatro mesas. Salí al amanecer con treinta años y la cara de un viejo, y el sol me dejó así. Llevaba tanto tiempo a oscuras que la primera luz me quemó.»", "siguiente": "p4_escucho_2", "solicitud": "historia:farolero_hablo", "retrato": ""}, "p4_escucho_2": {"personaje": "farolero", "texto": "«Aprende cuándo levantarte. Cada campanada es un año. Yo las conté tarde.»", "siguiente": "p4b_1", "retrato": ""}, "p4_ignacio_1": {"personaje": "farolero", "texto": "«El relojero. Pasó hace un año, silbando. Me dio la hora sin que se la pidiera. Iba adelantado tres minutos, y lo sabía.»", "siguiente": "p4_ignacio_2", "solicitud": "historia:farolero_hablo", "retrato": ""}, "p4_ignacio_2": {"personaje": "farolero", "texto": "«Esta noche lo he vuelto a oír. No silbaba. Decía un nombre. El tuyo.»", "siguiente": "p4b_1", "retrato": ""}, "p4_ignoro": {"personaje": "farolero", "texto": "«Tiempo es justo lo que vas a entregar. Año a año. Buenas noches, entonces. No volveremos a hablar.»", "siguiente": "p4b_1", "retrato": ""}, "p4b_1": {"personaje": "narrador", "texto": "El farolero levanta la pértiga y enciende una farola más adelante, donde un momento antes no había ninguna. Luego otra. Y otra. Las farolas se encienden una tras otra, hacia donde la calle debería acabar. Detrás de mí se apagan en el mismo orden.", "siguiente": "p4b_2", "modo": "nvl", "pagina_nueva": true, "escena": [{"sale": "todos"}], "fondo": "cg_camino_farolas"}, "p4b_2": {"personaje": "narrador", "texto": "Cuento los pasos, por costumbre. Ciento doce. Al ciento trece, la niebla se abre.", "siguiente": "p5_1", "modo": "nvl"}, "p5_1": {"personaje": "narrador", "texto": "No tiene ventanas. Donde deberían estar hay caras talladas en la piedra. Todas con los ojos cerrados.", "siguiente": "p5_2", "modo": "nvl", "fondo": "fachada_casa", "pagina_nueva": true}, "p5_2": {"personaje": "narrador", "texto": "Por la rendija de la puerta sale una luz cálida y un murmullo de cartas. Huele a cera, a terciopelo viejo, a algo dulce que tarda en ponerse rancio.", "siguiente": "p5_3", "modo": "nvl"}, "p5_3": {"personaje": "narrador", "texto": "El reloj de la fachada marca la medianoche exacta. No el minuto antes, como los míos. La medianoche.", "siguiente": "p5_que", "modo": "nvl"}, "p5_que": {"personaje": "narrador", "texto": "Antes de subir los peldaños…", "modo": "nvl", "opciones": [{"texto": "Tocar la ficha en el bolsillo.", "ir": "p5_ficha"}, {"texto": "Mirar atrás.", "ir": "p5_atras"}, {"texto": "Pensar en Ignacio.", "ir": "p5_ignacio"}]}, "p5_ficha": {"personaje": "narrador", "texto": "Está caliente. Late con el mismo ritmo que el lacre. Con el mismo ritmo que yo.", "siguiente": "p5_fin", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_ficha_late"}, "p5_atras": {"personaje": "narrador", "texto": "La calle ha desaparecido. No hay farolas, no hay puerto, no hay niebla. Solo negro. No hay adonde volver. O eso quiere la Casa que piense.", "siguiente": "p5_fin", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_calle_desaparece"}, "p5_ignacio": {"personaje": "narrador", "texto": "Tres minutos adelantado, dijo el farolero. Siempre llegaba antes. Esta vez llego yo un año tarde. O justo a tiempo, que es peor.", "siguiente": "p5_fin", "modo": "nvl", "pagina_nueva": true, "fondo": "fachada_casa"}, "p5_fin": {"personaje": "narrador", "texto": "Entra en la Casa.", "siguiente": "", "modo": "tarjeta", "solicitud": "historia:prologo_visto"}}
fondos = {"sala_dueno_noche": {"ruta": "res://historia/ilustraciones/sala_dueno_noche.webp", "movimiento": "desplazar", "descripcion": "La sala del Dueño de noche, desde detrás de la silla del visitante. La verja del alba al fondo, Máscaras en las paredes."}, "negro_con_grabado": {"ruta": "res://historia/ilustraciones/negro_con_grabado.webp", "descripcion": "Una invitación lacrada sobre terciopelo negro, junto a una Máscara boca abajo."}, "cg_ignacio_mascara": {"ruta": "res://historia/ilustraciones/cg_ignacio_mascara.webp", "movimiento": "acercar", "descripcion": "La mano de Ignacio sobre el tapete: Llave de 2, Reloj de 7 y la Máscara con su propio rostro."}, "taller_ferrer": {"ruta": "res://historia/ilustraciones/taller_ferrer.webp", "movimiento": "desplazar", "descripcion": "La relojería de Ferrer de noche: una pared de relojes, todos a las doce menos un minuto."}, "cg_invitacion": {"ruta": "res://historia/ilustraciones/cg_invitacion.webp", "movimiento": "acercar", "descripcion": "Dos manos manchadas de aceite sostienen el sobre negro con el lacre del sol tras la verja."}, "calle_niebla": {"ruta": "res://historia/ilustraciones/calle_niebla.webp", "movimiento": "desplazar", "descripcion": "La calle del puerto con niebla a la cintura y una farola de gas con un halo enorme."}, "fachada_casa": {"ruta": "res://historia/ilustraciones/fachada_casa.webp", "movimiento": "acercar", "descripcion": "La fachada sin ventanas de la Casa, con rostros tallados de ojos cerrados y la puerta entreabierta."}, "cg_relojes_parados": {"ruta": "res://historia/ilustraciones/cg_relojes_parados.webp", "descripcion": "La pared de treinta y dos relojes, todos a las doce menos un minuto; los péndulos quietos a mitad de recorrido.", "movimiento": "acercar"}, "cg_ventana_farola": {"ruta": "res://historia/ilustraciones/cg_ventana_farola.webp", "descripcion": "Tras la ventana empañada, la farola encendida sin farolero y, bajo ella, un hombre con levita verde que no tiene cara.", "movimiento": "acercar"}, "cg_reloj_helado": {"ruta": "res://historia/ilustraciones/cg_reloj_helado.webp", "descripcion": "Las manos de Klein abren un reloj de bolsillo: el volante quieto y una escarcha fina sobre el metal.", "movimiento": "acercar"}, "cg_invitacion_arde": {"ruta": "res://historia/ilustraciones/cg_invitacion_arde.webp", "descripcion": "La esquina de la invitación en la llama de la lámpara: el fuego se vuelve verde y el papel sigue intacto.", "movimiento": "acercar"}, "cg_reverso_perdoname": {"ruta": "res://historia/ilustraciones/cg_reverso_perdoname.webp", "descripcion": "El reverso de la tarjeta: una dirección y, debajo, una letra temblorosa que Klein reconoce.", "movimiento": "acercar"}, "cg_farolero": {"ruta": "res://historia/ilustraciones/cg_farolero.webp", "descripcion": "El farolero de ojos blancos, apoyado en su pértiga bajo la farola, con la niebla a la cintura.", "movimiento": "acercar"}, "cg_camino_farolas": {"ruta": "res://historia/ilustraciones/cg_camino_farolas.webp", "descripcion": "Las farolas se encienden en hilera hacia donde la calle debería acabar; detrás, se apagan.", "movimiento": "acercar"}, "cg_ficha_late": {"ruta": "res://historia/ilustraciones/cg_ficha_late.webp", "descripcion": "La ficha de marfil en la palma de Klein, con un pulso de luz dorada.", "movimiento": "acercar"}, "cg_calle_desaparece": {"ruta": "res://historia/ilustraciones/cg_calle_desaparece.webp", "descripcion": "Detrás de Klein, la calle ya no existe: solo negro y la escalinata de la Casa.", "movimiento": "acercar"}}
