[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"custodio": {"nombre": "El Custodio", "retrato": "res://recursos/arte/custodio-grabado.png", "expresiones": "res://historia/retratos/custodio_%s.webp"}, "narrador": {"nombre": ""}}
entradas = [{"si": "mesa_superada", "ir": "revisita"}, {"ir": "presentacion_1"}]
intervenciones = {"presentacion_1": {"personaje": "custodio", "texto": "«Siéntate, relojero. He guardado la primera silla para ti.»", "siguiente": "presentacion_2", "sonido": "campana"}, "presentacion_2": {"personaje": "custodio", "texto": "«Mi mesa es la más sencilla de la Casa: umbral {umbral}, meta {meta}, {campanadas} campanadas. Escucha lo que calla la Máscara antes de pedir otra carta.»", "siguiente": "presentacion_3"}, "presentacion_3": {"personaje": "custodio", "texto": "«Diez campanadas son diez años. Si las gastas todas aquí, saldrás de mi sala con canas, o no saldrás. No tengo prisa. Tú sí deberías tenerla.»", "siguiente": "asiento"}, "asiento": {"personaje": "custodio", "texto": "«Y no temas a la máscara. Hace siglos que no muerde a nadie.»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}]}, "asiento_otra": {"personaje": "custodio", "texto": "«¿Te sientas, entonces?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "respuesta_0_1": {"personaje": "custodio", "texto": "«El que cuenta. Cuento cada campanada que suena en esta Casa desde la primera noche. Antes de esta máscara fui campanero. Tocaba a muerto en una catedral que ya no existe. Aquí sigo haciendo lo mismo.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_1_1": {"personaje": "custodio", "texto": "«Diez años para aprender. El péndulo solo avanza cuando empiezas una mano; pensar no te cuesta nada. Piensa. Piensa siempre. Es lo único que la Casa no cobra.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_2_1": {"personaje": "custodio", "texto": "«Caras que no recuerdan su precio. Por eso no ves cuánto valen hasta plantarte. Si acercas el oído a la baraja, a veces se las oye rezar.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_3_1": {"personaje": "narrador", "texto": "Se oye una cadena moverse bajo la mesa.", "siguiente": "respuesta_3_2", "fondo": "cg_cadena_custodio", "efecto": "temblor"}, "respuesta_3_2": {"personaje": "custodio", "texto": "«Llegué hasta esta silla y perdí en ella. La Casa me dejó el cuerpo y me quitó las piernas. Contar es mejor que ser contado. Me lo repito cada noche.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_4_1": {"personaje": "custodio", "texto": "«¿Sigue vivo? Ganó las cuatro mesas. El sol le quemó los ojos al salir. Es el único que lo consiguió en mi tiempo… y mira cómo acabó.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "preguntas": {"personaje": "custodio", "texto": "«Pregunta. Pensar no cuesta campanadas.»", "opciones": [{"texto": "¿Quién es usted?", "ir": "respuesta_0_1"}, {"texto": "¿Por qué diez muescas en el péndulo?", "ir": "respuesta_1_1"}, {"texto": "¿Qué son las Máscaras?", "ir": "respuesta_2_1"}, {"texto": "¿Puede levantarse de esa silla?", "ir": "respuesta_3_1"}, {"texto": "Conocí al farolero.", "ir": "respuesta_4_1", "si": "historia:farolero_hablo"}, {"texto": "Nada más", "ir": "asiento_otra"}], "fondo": ""}, "preguntas_revisita": {"personaje": "custodio", "texto": "«Pregunta. Pensar no cuesta campanadas.»", "opciones": [{"texto": "¿Qué perdió antes de llegar aquí?", "ir": "pos_respuesta_1", "si": "no:historia:custodio_pos_respuesta_1"}, {"texto": "¿Qué recuerda de su primera noche aquí?", "ir": "pos_respuesta_2", "si": "no:historia:custodio_pos_respuesta_2"}, {"texto": "¿Queda algo de su ciudad allá fuera?", "ir": "pos_respuesta_3", "si": "no:historia:custodio_pos_respuesta_3"}, {"texto": "Nada más", "ir": ""}], "fondo": ""}, "revisita": {"personaje": "custodio", "texto": "«La mesa está cerrada, pero el péndulo te recuerda. Te quedan años, relojero. No los malgastes preguntándome.»", "siguiente": "preguntas_revisita", "fondo": ""}, "victoria": {"personaje": "custodio", "texto": "«{meta}. Has contado bien. Toma el primer sello y ponlo en el reloj. Oirás un tic. Uno solo. Ese tic es el primer segundo que la Casa pierde en mucho tiempo. Ve con el Recaudador. Y no le debas nada. Él no olvida.»"}, "derrota": {"personaje": "custodio", "texto": "«La última campanada. Lo siento. Contaré la tuya con cuidado. Es lo único que puedo hacer por ti.»"}, "pos_respuesta_1": {"personaje": "custodio", "solicitud": "historia:custodio_pos_respuesta_1", "expresion": "recuerdo", "texto": "«Tres hijos. Andrés, Tomás y Gil, el pequeño. Toqué a muerto por los tres, un domingo cada uno. El obispo pagaba cada toque.»\n\n«Con lo de Gil compré pan. Esa es la parte que no me perdono.»", "opciones": [{"texto": "¿Cómo fue aquel último toque?", "ir": "", "solicitud": "ver_recuerdo"}, {"texto": "Otra pregunta.", "ir": "preguntas_revisita"}]}, "pos_respuesta_2": {"personaje": "custodio", "solicitud": "historia:custodio_pos_respuesta_2", "siguiente": "preguntas_revisita", "texto": "«Que el minutero del vestíbulo todavía temblaba, como un perro que quiere salir. Fui de los primeros. La anfitriona apenas tosía y el Dueño todavía se reía.»\n\n«Hace mucho que nadie se ríe en esta Casa. Tú lo intentas. Se agradece.»"}, "pos_respuesta_3": {"personaje": "custodio", "solicitud": "historia:custodio_pos_respuesta_3", "siguiente": "preguntas_revisita", "texto": "«Un visitante me contó que la catedral ardió poco después de que yo entrara. La campana mayor se fundió y con el bronce acuñaron monedas.»\n\n«Alguna habrá llegado a Corvera. Si oyes una moneda que suena más grave que las demás, no la gastes. Es de las mías.»"}, "pos_fin_recuerdo": {"personaje": "custodio", "expresion": "duelo", "texto": "«Ya está. Pregunta otra cosa, si quieres. O ve a vivir un poco.»", "siguiente": "preguntas_revisita"}}
fondos = {"cg_cadena_custodio": {"ruta": "res://historia/ilustraciones/cg_cadena_custodio.webp", "movimiento": "acercar", "descripcion": "Bajo la mesa del Custodio, una cadena de hierro le sujeta a la silla por los tobillos; los eslabones gastados de tanto tirar."}}
