[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"benavides": {"nombre": "Señor Benavides"}, "narrador": {"nombre": ""}}
entradas = [{"si": "sellos>=3", "ir": "porcelana"}, {"ir": "saludo"}]
intervenciones = {"respuesta_1": {"personaje": "benavides", "texto": "«Él me dio sus quince de cortesía. Y luego me cobró una por cada carta. Quince cartas más tarde, ya no podía pedir. Ni una. Me quedé mirando un catorce durante seis campanadas.»", "siguiente": "preguntas"}, "respuesta_2": {"personaje": "benavides", "texto": "«Daba fe de los contratos ajenos. Firmé el mío sin leerlo. Usted también lo firmó, ¿sabe? Cuando aceptó la ficha.»", "siguiente": "preguntas"}, "respuesta_3": {"personaje": "benavides", "texto": "«Mi esposa me ofreció como garantía para jugar una mano más. La ganó. Salió al amanecer.»\n\n«Pero una garantía ofrecida ya es una deuda, y la Casa me escribió igual. Ella nunca volvió a buscarme.»\n\n«Hizo bien.»", "siguiente": "preguntas", "expresion": "triste"}, "saludo": {"personaje": "benavides", "texto": "«Lo gasté todo en la tienda. Todo. Corona, Sello, ajustes… Llegué a la mesa del Recaudador sin una ficha en el bolsillo.»", "opciones": [{"texto": "¿Y qué pasó?", "ir": "respuesta_1"}, {"texto": "¿Era usted notario de verdad?", "ir": "respuesta_2"}, {"texto": "¿Usted también tuvo una garantía?", "ir": "respuesta_3", "si": "historia:lore.garantia"}, {"texto": "Volver al recorrido", "ir": ""}]}, "preguntas": {"personaje": "benavides", "texto": "¿Quieres preguntar algo más?", "opciones": [{"texto": "¿Y qué pasó?", "ir": "respuesta_1"}, {"texto": "¿Era usted notario de verdad?", "ir": "respuesta_2"}, {"texto": "¿Usted también tuvo una garantía?", "ir": "respuesta_3", "si": "historia:lore.garantia"}, {"texto": "Volver al recorrido", "ir": ""}]}, "porcelana": {"personaje": "narrador", "texto": "Benavides sostiene el portafolios con manos de porcelana. Ya no respira."}}
