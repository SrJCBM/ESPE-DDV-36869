[gd_resource type="Resource" script_class="Conversacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://casino/dialogos/conversacion.gd" id="1_conv"]

[resource]
script = ExtResource("1_conv")
personajes = {"coleccionista": {"nombre": "La Coleccionista", "retrato": "res://casino/arte/personaje_coleccionista.webp", "expresiones": "res://historia/retratos/coleccionista_%s.webp"}, "narrador": {"nombre": ""}}
entradas = [{"si": "mesa_superada", "ir": "revisita"}, {"ir": "presentacion_1"}]
intervenciones = {"presentacion_1": {"personaje": "coleccionista", "texto": "«Un relojero. Qué manos tan finas… Acércate. Deja que vea qué traes. No toques el cristal. Las huellas no se van; lo sé por experiencia.»", "siguiente": "asiento", "expresion": "codicia"}, "asiento": {"personaje": "coleccionista", "texto": "«Quédate con los puntos. Yo conservaré la carta más alta de cada mano, incluso si te pasas. Umbral {umbral}, meta {meta}, {campanadas} campanadas. Al levantarte te devuelvo las cartas. A ti, en cambio, quizá no.»", "siguiente": [{"si": "no:historia:vio_vitrina", "ir": "vitrina_1"}, {"ir": "asiento_tras"}]}, "asiento_tras": {"personaje": "coleccionista", "texto": "«¿Te sientas?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "asiento_otra": {"personaje": "coleccionista", "texto": "«¿Te sientas, entonces?»", "opciones": [{"texto": "Tomar asiento", "ir": "", "solicitud": "tomar_asiento"}, {"texto": "Preguntar…", "ir": "preguntas"}, {"texto": "Volver a la sala", "ir": ""}], "fondo": ""}, "respuesta_0_1": {"personaje": "coleccionista", "texto": "«Porque lo mejor de cada mano merece una vitrina. Tú te quedas los puntos; yo, el instante. Algún día también te quedarás tú.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_1_1": {"personaje": "coleccionista", "texto": "«Visitantes. Cada uno vale lo que valía su última apuesta, y ninguno lo recuerda. Se esconden hasta que te plantas porque les avergüenza su precio. O porque tienen miedo. Nunca les he preguntado.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_2_1": {"personaje": "coleccionista", "texto": "«Marchante de arte. Tuve una hija tan hermosa que la guardé tras un cristal para que nada la rompiera. La fiebre no necesitó romper nada. Ahora guardo otras cosas. Y no puedo tocar ninguna sin guantes.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "respuesta_3_1": {"personaje": "coleccionista", "texto": "«Qué pregunta tan vulgar. Dicen que el Dueño puede. Nunca lo ha hecho. Nunca nadie le ha ganado lo suficiente como para pedírselo.»", "siguiente": [{"si": "mesa_superada", "ir": "preguntas_revisita"}, {"ir": "preguntas"}]}, "preguntas": {"personaje": "coleccionista", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Por qué se queda con mis mejores cartas?", "ir": "respuesta_0_1"}, {"texto": "¿Qué son todas esas Máscaras?", "ir": "respuesta_1_1"}, {"texto": "¿Qué era usted antes?", "ir": "respuesta_2_1"}, {"texto": "¿Puede volver alguien de una Máscara?", "ir": "respuesta_3_1", "si": "historia:vio_vitrina"}, {"texto": "Nada más", "ir": "asiento_otra"}], "fondo": ""}, "preguntas_revisita": {"personaje": "coleccionista", "texto": "«Pregunta.»", "opciones": [{"texto": "¿Por qué se queda con mis mejores cartas?", "ir": "respuesta_0_1"}, {"texto": "¿Qué son todas esas Máscaras?", "ir": "respuesta_1_1"}, {"texto": "¿Qué era usted antes?", "ir": "respuesta_2_1"}, {"texto": "¿Puede volver alguien de una Máscara?", "ir": "respuesta_3_1", "si": "historia:vio_vitrina"}, {"texto": "Nada más", "ir": ""}], "fondo": ""}, "revisita": {"personaje": "coleccionista", "texto": "«¿Vuelves a mirarlo? Puedes. Mirar todavía es gratis.»", "siguiente": "preguntas_revisita", "fondo": ""}, "victoria": {"personaje": "coleccionista", "texto": "«{meta}… y aún te quedan cartas buenas. Qué desperdicio. El tercer sello. Llévatelo antes de que cambie de idea.»"}, "derrota": {"personaje": "coleccionista", "texto": "«La última campanada. Ven. Déjame mirarte bien antes de que termine. Os pondré juntos, a ti y a tu maestro. Es lo justo.»"}, "vitrina_1": {"personaje": "narrador", "modo": "nvl", "pagina_nueva": true, "fondo": "cg_vitrina_ignacio", "solicitud": "historia:vio_vitrina", "texto": "Entre cartas de oro y marfil hay una Máscara de porcelana. Es él. La barba, la cicatriz de la ceja que se hizo con un muelle real. Los ojos cerrados, como cuando se dormía en el banco de trabajo.", "siguiente": "vitrina_2"}, "vitrina_2": {"personaje": "narrador", "modo": "nvl", "texto": "Está llorando. La porcelana no llora. Él sí.", "siguiente": "vitrina_3"}, "vitrina_3": {"personaje": "narrador", "modo": "nvl", "texto": "En la etiqueta, con letra muy pequeña: «Ferrer. Una pieza de diez. Adquirida en la última mesa, junto con su garantía.»", "siguiente": [{"si": "historia:garantia", "ir": "vitrina_garantia"}, {"ir": "vitrina_opciones"}]}, "vitrina_garantia": {"personaje": "narrador", "modo": "nvl", "texto": "Junto con su garantía. Conmigo. Quiero romper el cristal. Quiero romperle la cara. No sé cuál de las dos cosas.", "siguiente": "vitrina_opciones"}, "vitrina_opciones": {"personaje": "coleccionista", "fondo": "", "texto": "«Mi pieza más reciente. ¿Te gusta?»", "opciones": [{"texto": "Devuélvamelo.", "ir": "vitrina_devuelva"}, {"texto": "¿Sabe que estoy aquí?", "ir": "vitrina_sabe"}, {"texto": "Que se quede ahí.", "ir": "vitrina_quede", "si": "historia:garantia"}, {"texto": "…", "ir": "vitrina_silencio"}]}, "vitrina_devuelva": {"personaje": "coleccionista", "texto": "«Yo no devuelvo, querido. Conservo. Gánate mi sello y te dejaré mirarlo de cerca. Quizá él te mire a ti.»", "siguiente": [{"si": "historia:motivo=ignacio", "ir": "piensa_ignacio"}, {"si": "historia:motivo=taller", "ir": "piensa_taller"}, {"si": "historia:motivo=curiosidad", "ir": "piensa_curiosidad"}, {"ir": "asiento_tras"}]}, "vitrina_sabe": {"personaje": "coleccionista", "expresion": "deleite", "texto": "«Todas lo saben. Las Máscaras sienten el calor de quien se acerca. Mira cómo llora. Nunca había llorado.»", "siguiente": [{"si": "historia:motivo=ignacio", "ir": "piensa_ignacio"}, {"si": "historia:motivo=taller", "ir": "piensa_taller"}, {"si": "historia:motivo=curiosidad", "ir": "piensa_curiosidad"}, {"ir": "asiento_tras"}]}, "vitrina_quede": {"personaje": "coleccionista", "texto": "«Oh. Eso no lo esperaba. Qué pieza tan interesante eres tú también.»", "siguiente": [{"si": "historia:motivo=ignacio", "ir": "piensa_ignacio"}, {"si": "historia:motivo=taller", "ir": "piensa_taller"}, {"si": "historia:motivo=curiosidad", "ir": "piensa_curiosidad"}, {"ir": "asiento_tras"}]}, "vitrina_silencio": {"personaje": "coleccionista", "texto": "«Lo conocías. Eso lo hace más valioso. Y a ti también.»", "siguiente": [{"si": "historia:motivo=ignacio", "ir": "piensa_ignacio"}, {"si": "historia:motivo=taller", "ir": "piensa_taller"}, {"si": "historia:motivo=curiosidad", "ir": "piensa_curiosidad"}, {"ir": "asiento_tras"}]}, "piensa_ignacio": {"personaje": "narrador", "texto": "Vine a salvarlo. Ahora no sé si quiero. Sé que voy a seguir. No sé si por él o contra él.", "siguiente": "asiento_tras"}, "piensa_taller": {"personaje": "narrador", "texto": "El taller, las deudas, el embargo. Eran suyas. Siempre fueron suyas. Yo era otra de sus deudas.", "siguiente": "asiento_tras"}, "piensa_curiosidad": {"personaje": "narrador", "texto": "Ahora sé lo que son las Máscaras. Las tengo en la baraja. Las he jugado. Las he sentido calientes.", "siguiente": "asiento_tras"}}
fondos = {"cg_vitrina_ignacio": {"ruta": "res://historia/ilustraciones/cg_vitrina_ignacio.webp", "movimiento": "acercar", "descripcion": "La vitrina con la Máscara de Ignacio: barba, cicatriz en la ceja y una gota bajo el ojo."}}
